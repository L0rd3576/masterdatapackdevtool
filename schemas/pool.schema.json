{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pool.schema.json",
  "title": "Pool config: which minigames, maps and presets are in rotation, with selection weights",
  "type": "object",
  "required": ["minigames", "maps"],
  "properties": {
    "$schema": {"type": "string"},
    "description": {"type": "string"},
    "minigames": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id"],
        "properties": {
          "id": {"$ref": "common.schema.json#/definitions/id"},
          "enabled": {"type": "boolean", "default": true},
          "weight": {"type": "number", "minimum": 0, "default": 1, "description": "Relative pick weight."},
          "presets": {
            "type": "array",
            "description": "Presets to rotate for this minigame; omit to use only the manifest defaults.",
            "items": {
              "type": "object", "required": ["id"],
              "properties": {
                "id": {"$ref": "common.schema.json#/definitions/id"},
                "weight": {"type": "number", "minimum": 0, "default": 1}
              },
              "additionalProperties": false
            }
          },
          "include_default": {"type": "boolean", "default": true, "description": "Also rotate the minigame with its default settings."}
        },
        "additionalProperties": false
      }
    },
    "maps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id"],
        "properties": {
          "id": {"$ref": "common.schema.json#/definitions/id"},
          "enabled": {"type": "boolean", "default": true},
          "weight": {"type": "number", "minimum": 0, "default": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

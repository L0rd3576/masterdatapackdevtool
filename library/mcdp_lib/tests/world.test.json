{
  "description": "world/*: fill, setblock, clone, place_template, tp, tp_stored, safe_spawn (+lava), safe_spawn_tp, fill_spread over ticks with callback",
  "setup": ["scoreboard objectives add mcdp_lib_t dummy", "scoreboard players reset * mcdp_lib_t", "kill @e[type=minecraft:marker]",
            "summon minecraft:marker 0 -60 0 {Tags:[\"t.w\"]}"],
  "steps": [
    {"run": "execute store result score #r mcdp_lib_t run function mcdp_lib:world/fill {x1:20,y1:-60,z1:20,x2:22,y2:-58,z2:22,block:\"minecraft:stone\",mode:\"replace\"}"},
    {"assert_score": {"target": "#r", "objective": "mcdp_lib_t", "equals": 27}},
    {"run": "execute store result score #r mcdp_lib_t run function mcdp_lib:world/setblock {x:20,y:-57,z:20,block:\"minecraft:gold_block\"}"},
    {"assert_score": {"target": "#r", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "execute store result score #r mcdp_lib_t run function mcdp_lib:world/setblock {x:20,y:-57,z:20,block:\"minecraft:gold_block\"}"},
    {"assert_score": {"target": "#r", "objective": "mcdp_lib_t", "equals": 0}},
    {"run": "function mcdp_lib:world/clone {x1:20,y1:-60,z1:20,x2:22,y2:-57,z2:22,x:30,y:-60,z:20,mode:\"replace\"}"},
    {"assert": "if block 30 -57 20 minecraft:gold_block"},
    {"assert": "if block 32 -60 22 minecraft:stone"},
    {"run": "execute store result score #r mcdp_lib_t run function mcdp_lib:world/place_template {template:\"minecraft:igloo/top\",x:50,y:-60,z:0}"},
    {"assert_score": {"target": "#r", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "execute as @n[type=minecraft:marker,tag=t.w] run function mcdp_lib:world/tp {x:1.5,y:-50,z:2.5,dimension:\"minecraft:overworld\"}"},
    {"assert_data": {"source": "entity @n[type=minecraft:marker,tag=t.w]", "path": "Pos", "equals": "[1.5d,-50.0d,2.5d]"}},
    {"run": "data modify storage mcdp_lib_test:o spot set value {x:5.5d,y:-55.0d,z:5.5d,dimension:\"minecraft:overworld\"}"},
    {"run": "execute as @n[type=minecraft:marker,tag=t.w] run function mcdp_lib:world/tp_stored {storage:\"mcdp_lib_test:o\",path:\"spot\"}"},
    {"assert_data": {"source": "entity @n[type=minecraft:marker,tag=t.w]", "path": "Pos", "equals": "[5.5d,-55.0d,5.5d]"}},
    {"run": "execute store success score #ok mcdp_lib_t run function mcdp_lib:world/safe_spawn {x:3,z:3}"},
    {"assert_score": {"target": "#ok", "objective": "mcdp_lib_t", "equals": 1}},
    {"assert_score": {"target": "#result", "objective": "mcdp_lib.out", "equals": -60}},
    {"assert": "unless entity @e[type=minecraft:marker,tag=mcdp_lib.pos]"},
    {"run": "setblock 4 -61 4 minecraft:lava"},
    {"run": "execute store success score #ok mcdp_lib_t run function mcdp_lib:world/safe_spawn {x:4,z:4}"},
    {"assert_score": {"target": "#ok", "objective": "mcdp_lib_t", "equals": 0}},
    {"run": "execute as @n[type=minecraft:marker,tag=t.w] run function mcdp_lib:world/safe_spawn_tp {x:7,z:7}"},
    {"assert": "if entity @e[type=minecraft:marker,tag=t.w,x=7.5,y=-60,z=7.5,distance=..0.6]"},
    {"run": "execute store result score #r mcdp_lib_t run function mcdp_lib:world/fill_spread {x1:40,y1:-51,z1:40,x2:42,y2:-60,z2:42,block:\"minecraft:glass\",layers:4,callback:\"mcdp_lib_test:cb\"}"},
    {"assert_score": {"target": "#r", "objective": "mcdp_lib_t", "equals": 1}},
    {"ticks": 1},
    {"assert": "if block 41 -57 41 minecraft:glass"},
    {"assert": "if block 41 -56 41 minecraft:air"},
    {"ticks": 1},
    {"assert": "if block 41 -53 41 minecraft:glass"},
    {"assert": "if block 41 -52 41 minecraft:air"},
    {"assert": "unless score #cb mcdp_lib_t matches 1.."},
    {"ticks": 1},
    {"assert": "if block 42 -51 42 minecraft:glass"},
    {"assert_score": {"target": "#cb", "objective": "mcdp_lib_t", "equals": 1}},
    {"assert_data": {"source": "storage mcdp_lib:internal", "path": "fill_jobs", "equals": "[]"}},
    {"run": "function mcdp_lib:world/fill {x1:0,y1:0,z1:0}", "expect_error": "Missing argument"}
  ],
  "teardown": ["kill @e[type=minecraft:marker]", "fill 20 -60 20 32 -57 22 minecraft:air", "fill 40 -60 40 42 -51 42 minecraft:air",
               "setblock 4 -61 4 minecraft:grass_block", "fill 45 -60 -5 60 -50 10 minecraft:air"]
}

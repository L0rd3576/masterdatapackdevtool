{
  "description": "rules/*: apply gamerules + effects to targets, revert to previous values, re-apply replaces the old struct",
  "setup": ["scoreboard objectives add mcdp_lib_t dummy", "kill @e[type=!minecraft:player]", "gamerule pvp true", "gamerule keep_inventory false",
            "summon minecraft:zombie 6 -60 6 {NoAI:1b,Silent:1b,Tags:[\"t.r\"]}"],
  "steps": [
    {"run": "data modify storage mcdp_lib:in rules set value {pvp:0b,keep_inventory:1b,gamemode:\"adventure\",block_break:0b,effects:[{id:\"minecraft:speed\",duration:\"infinite\",amplifier:1,hide:1b}]}"},
    {"run": "function mcdp_lib:rules/apply {targets:\"@e[tag=t.r]\"}"},
    {"assert_output": {"command": "gamerule pvp", "contains": "set to false"}},
    {"assert_output": {"command": "gamerule keep_inventory", "contains": "set to true"}},
    {"assert": "if entity @e[tag=t.r,tag=mcdp_lib.ruled]"},
    {"assert_data": {"source": "entity @n[tag=t.r]", "path": "active_effects[0].id", "equals": "\"minecraft:speed\""}},
    {"run": "summon minecraft:zombie 8 -60 6 {NoAI:1b,Silent:1b,Tags:[\"t.late\"]}"},
    {"run": "execute as @n[tag=t.late] run function mcdp_lib:rules/apply_self"},
    {"assert_data": {"source": "entity @n[tag=t.late]", "path": "active_effects[0].id", "equals": "\"minecraft:speed\""}},
    {"run": "function mcdp_lib:rules/revert"},
    {"assert": "unless data entity @n[tag=t.late] active_effects[0]"},
    {"run": "execute as @n[tag=t.late] store success score #ok mcdp_lib_t run function mcdp_lib:rules/apply_self"},
    {"assert_score": {"target": "#ok", "objective": "mcdp_lib_t", "equals": 0}},
    {"assert_output": {"command": "gamerule pvp", "contains": "set to true"}},
    {"assert_output": {"command": "gamerule keep_inventory", "contains": "set to false"}},
    {"assert": "unless data entity @n[tag=t.r] active_effects[0]"},
    {"assert": "unless entity @e[tag=mcdp_lib.ruled]"},
    {"run": "execute store success score #ok mcdp_lib_t run function mcdp_lib:rules/revert"},
    {"assert_score": {"target": "#ok", "objective": "mcdp_lib_t", "equals": 0}},
    {"run": "data modify storage mcdp_lib:in rules set value {pvp:0b}"},
    {"run": "function mcdp_lib:rules/apply {targets:\"@e[tag=t.r]\"}"},
    {"run": "data modify storage mcdp_lib:in rules set value {keep_inventory:1b}"},
    {"run": "function mcdp_lib:rules/apply {targets:\"@e[tag=t.r]\"}"},
    {"assert_output": {"command": "gamerule pvp", "contains": "set to true"}},
    {"assert_output": {"command": "gamerule keep_inventory", "contains": "set to true"}},
    {"run": "function mcdp_lib:rules/revert"},
    {"assert_output": {"command": "gamerule keep_inventory", "contains": "set to false"}},
    {"run": "function mcdp_lib:rules/apply {}", "expect_error": "Missing argument targets"}
  ],
  "teardown": ["kill @e[type=!minecraft:player]", "gamerule pvp true", "gamerule keep_inventory false"]
}

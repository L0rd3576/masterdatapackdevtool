{
  "description": "score/*: ensure, set, add, reset, compare, matches, storage copy, clamp, counters",
  "setup": ["scoreboard objectives add mcdp_lib_t dummy", "scoreboard players reset * mcdp_lib_t", "kill @e[type=minecraft:marker]"],
  "steps": [
    {"run": "function mcdp_lib:score/ensure {name:\"t.obj\",criteria:\"dummy\"}"},
    {"run": "function mcdp_lib:score/ensure {name:\"t.obj\",criteria:\"dummy\"}"},
    {"assert_output": {"command": "scoreboard objectives list", "contains": "[t.obj]"}},
    {"run": "execute store result score #r mcdp_lib_t run function mcdp_lib:score/set {target:\"#a\",objective:\"t.obj\",value:5}"},
    {"assert_score": {"target": "#r", "objective": "mcdp_lib_t", "equals": 5}},
    {"run": "function mcdp_lib:score/add {target:\"#a\",objective:\"t.obj\",value:-7}"},
    {"assert_score": {"target": "#a", "objective": "t.obj", "equals": -2}},
    {"run": "function mcdp_lib:score/add {target:\"#new\",objective:\"t.obj\",value:3}"},
    {"assert_score": {"target": "#new", "objective": "t.obj", "equals": 3}},
    {"run": "execute store result score #c mcdp_lib_t run function mcdp_lib:score/compare {a:\"#a\",a_objective:\"t.obj\",op:\"<\",b:\"#new\",b_objective:\"t.obj\"}"},
    {"assert_score": {"target": "#c", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "execute store result score #c mcdp_lib_t run function mcdp_lib:score/compare {a:\"#a\",a_objective:\"t.obj\",op:\">=\",b:\"#new\",b_objective:\"t.obj\"}"},
    {"assert_score": {"target": "#c", "objective": "mcdp_lib_t", "equals": 0}},
    {"run": "execute store result score #m mcdp_lib_t run function mcdp_lib:score/matches {target:\"#a\",objective:\"t.obj\",range:\"..-1\"}"},
    {"assert_score": {"target": "#m", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "function mcdp_lib:score/to_storage {target:\"#new\",objective:\"t.obj\",storage:\"mcdp_lib_test:o\",path:\"n\"}"},
    {"assert_data": {"source": "storage mcdp_lib_test:o", "path": "n", "equals": "3"}},
    {"run": "function mcdp_lib:score/from_storage {storage:\"mcdp_lib_test:o\",path:\"n\",target:\"#copy\",objective:\"t.obj\",scale:10}"},
    {"assert_score": {"target": "#copy", "objective": "t.obj", "equals": 30}},
    {"run": "execute store success score #ok mcdp_lib_t run function mcdp_lib:score/from_storage {storage:\"mcdp_lib_test:o\",path:\"missing\",target:\"#copy\",objective:\"t.obj\",scale:1}"},
    {"assert_score": {"target": "#ok", "objective": "mcdp_lib_t", "equals": 0}},
    {"assert_score": {"target": "#copy", "objective": "t.obj", "equals": 30}},
    {"run": "function mcdp_lib:score/clamp {target:\"#copy\",objective:\"t.obj\",min:0,max:20}"},
    {"assert_score": {"target": "#copy", "objective": "t.obj", "equals": 20}},
    {"run": "summon minecraft:marker 1 -60 1 {Tags:[\"t.c\"]}"},
    {"run": "execute as @n[type=minecraft:marker,tag=t.c] run function mcdp_lib:score/counter_self {objective:\"t.wins\",amount:2}"},
    {"run": "execute as @n[type=minecraft:marker,tag=t.c] run function mcdp_lib:score/counter_self {objective:\"t.wins\",amount:2}"},
    {"assert_score": {"target": "@n[type=minecraft:marker,tag=t.c]", "objective": "t.wins", "equals": 4}},
    {"run": "function mcdp_lib:score/counter_global {objective:\"t.rounds\",amount:1}"},
    {"assert_score": {"target": "#global", "objective": "t.rounds", "equals": 1}},
    {"run": "function mcdp_lib:score/reset {target:\"*\",objective:\"t.obj\"}"},
    {"assert_output": {"command": "scoreboard players get #a t.obj", "contains": "none is set"}},
    {"run": "function mcdp_lib:score/set {target:\"#a\",objective:\"t.obj\"}", "expect_error": "Missing argument value"}
  ],
  "teardown": ["kill @e[type=minecraft:marker]"]
}

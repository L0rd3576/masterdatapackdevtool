{
  "description": "flow/*: after (schedule), after_as (keeps @s), repeat (count, index, nesting, cap, break)",
  "setup": ["scoreboard objectives add mcdp_lib_t dummy", "scoreboard players reset * mcdp_lib_t", "kill @e[type=minecraft:marker]",
            "summon minecraft:marker 1 -60 1 {Tags:[\"t.f\"]}"],
  "steps": [
    {"run": "function mcdp_lib:flow/after {ticks:3,function:\"mcdp_lib_test:cb\"}"},
    {"ticks": 2},
    {"assert": "unless score #cb mcdp_lib_t matches 1.."},
    {"ticks": 1},
    {"assert_score": {"target": "#cb", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "execute as @n[type=minecraft:marker,tag=t.f] run function mcdp_lib:flow/after_as {ticks:3,function:\"mcdp_lib_test:cb_self\"}"},
    {"ticks": 2},
    {"assert": "unless score @n[type=minecraft:marker,tag=t.f] mcdp_lib_t matches 1.."},
    {"ticks": 1},
    {"assert_score": {"target": "@n[type=minecraft:marker,tag=t.f]", "objective": "mcdp_lib_t", "equals": 1}},
    {"assert_data": {"source": "storage mcdp_lib:internal", "path": "wait", "equals": "[]"}},
    {"run": "execute store result score #r mcdp_lib_t run function mcdp_lib:flow/repeat {function:\"mcdp_lib_test:rep_cb\",times:5}"},
    {"assert_score": {"target": "#r", "objective": "mcdp_lib_t", "equals": 5}},
    {"assert_score": {"target": "#rep", "objective": "mcdp_lib_t", "equals": 5}},
    {"assert_score": {"target": "#isum", "objective": "mcdp_lib_t", "equals": 10}},
    {"run": "scoreboard players set #rep mcdp_lib_t 0"},
    {"run": "function mcdp_lib:flow/repeat {function:\"mcdp_lib_test:rep_nested\",times:3}"},
    {"assert_score": {"target": "#rep", "objective": "mcdp_lib_t", "equals": 12}},
    {"run": "scoreboard players set #rep mcdp_lib_t 0"},
    {"run": "data modify storage mcdp_lib:config max_repeat set value 3"},
    {"run": "execute store result score #r mcdp_lib_t run function mcdp_lib:flow/repeat {function:\"mcdp_lib_test:rep_cb\",times:10}"},
    {"run": "data modify storage mcdp_lib:config max_repeat set value 1000"},
    {"assert_score": {"target": "#r", "objective": "mcdp_lib_t", "equals": 3}},
    {"run": "scoreboard players set #rep mcdp_lib_t 0"},
    {"run": "execute store result score #r mcdp_lib_t run function mcdp_lib:flow/repeat {function:\"mcdp_lib_test:rep_break\",times:10}"},
    {"assert_score": {"target": "#rep", "objective": "mcdp_lib_t", "equals": 3}},
    {"assert_data": {"source": "storage mcdp_lib:internal", "path": "rep", "equals": "[]"}},
    {"run": "execute store success score #ok mcdp_lib_t run function mcdp_lib:flow/break"},
    {"assert_score": {"target": "#ok", "objective": "mcdp_lib_t", "equals": 0}},
    {"run": "function mcdp_lib:flow/repeat {function:\"mcdp_lib_test:cb\"}", "expect_error": "Missing argument times"}
  ],
  "teardown": ["kill @e[type=minecraft:marker]"]
}

{
  "description": "timer/*: per-entity and global timers, callbacks, cooldown check, pause/resume (global and per entity), stop",
  "setup": ["scoreboard objectives add mcdp_lib_t dummy", "scoreboard players reset * mcdp_lib_t", "kill @e[type=minecraft:marker]",
            "summon minecraft:marker 1 -60 1 {Tags:[\"t.a\"]}", "summon minecraft:marker 2 -60 2 {Tags:[\"t.b\"]}"],
  "steps": [
    {"run": "function mcdp_lib:timer/create {name:\"t.cd\",callback:\"mcdp_lib_test:cb_self\"}"},
    {"run": "execute as @n[type=minecraft:marker,tag=t.a] run function mcdp_lib:timer/start {name:\"t.cd\",ticks:3}"},
    {"run": "execute as @n[type=minecraft:marker,tag=t.b] run function mcdp_lib:timer/start {name:\"t.cd\",ticks:5}"},
    {"run": "execute as @n[type=minecraft:marker,tag=t.b] run function mcdp_lib:timer/pause_self {name:\"t.cd\"}"},
    {"run": "execute as @n[type=minecraft:marker,tag=t.a] store result score #ready mcdp_lib_t run function mcdp_lib:timer/ready {name:\"t.cd\"}"},
    {"assert_score": {"target": "#ready", "objective": "mcdp_lib_t", "equals": 0}},
    {"ticks": 2},
    {"run": "execute as @n[type=minecraft:marker,tag=t.a] store result score #left mcdp_lib_t run function mcdp_lib:timer/remaining {name:\"t.cd\"}"},
    {"assert_score": {"target": "#left", "objective": "mcdp_lib_t", "equals": 1}},
    {"assert": "unless score @n[type=minecraft:marker,tag=t.a] mcdp_lib_t matches 1.."},
    {"ticks": 1},
    {"assert_score": {"target": "@n[type=minecraft:marker,tag=t.a]", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "execute as @n[type=minecraft:marker,tag=t.a] store result score #ready mcdp_lib_t run function mcdp_lib:timer/ready {name:\"t.cd\"}"},
    {"assert_score": {"target": "#ready", "objective": "mcdp_lib_t", "equals": 1}},
    {"assert_score": {"target": "@n[type=minecraft:marker,tag=t.b]", "objective": "t.cd", "equals": 5}},
    {"run": "execute as @n[type=minecraft:marker,tag=t.b] run function mcdp_lib:timer/resume_self {name:\"t.cd\"}"},
    {"ticks": 5},
    {"assert_score": {"target": "@n[type=minecraft:marker,tag=t.b]", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "execute as @n[type=minecraft:marker,tag=t.a] run function mcdp_lib:timer/start {name:\"t.cd\",ticks:2}"},
    {"run": "execute as @n[type=minecraft:marker,tag=t.a] run function mcdp_lib:timer/stop {name:\"t.cd\"}"},
    {"ticks": 3},
    {"assert_score": {"target": "@n[type=minecraft:marker,tag=t.a]", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "function mcdp_lib:timer/create {name:\"t.g\",callback:\"mcdp_lib_test:cb\"}"},
    {"run": "function mcdp_lib:timer/start_global {name:\"t.g\",ticks:2}"},
    {"run": "function mcdp_lib:timer/pause {name:\"t.g\"}"},
    {"ticks": 3},
    {"run": "execute store result score #left mcdp_lib_t run function mcdp_lib:timer/remaining_global {name:\"t.g\"}"},
    {"assert_score": {"target": "#left", "objective": "mcdp_lib_t", "equals": 2}},
    {"run": "function mcdp_lib:timer/resume {name:\"t.g\"}"},
    {"ticks": 1},
    {"assert": "unless score #cb mcdp_lib_t matches 1.."},
    {"ticks": 1},
    {"assert_score": {"target": "#cb", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "function mcdp_lib:timer/start_global {name:\"t.g\",ticks:5}"},
    {"run": "function mcdp_lib:timer/stop_global {name:\"t.g\"}"},
    {"ticks": 6},
    {"assert_score": {"target": "#cb", "objective": "mcdp_lib_t", "equals": 1}},
    {"run": "execute store success score #ok mcdp_lib_t run function mcdp_lib:timer/pause {name:\"t.none\"}"},
    {"assert_score": {"target": "#ok", "objective": "mcdp_lib_t", "equals": 0}},
    {"run": "data remove storage mcdp_lib:internal timers[{name:\"t.cd\"}]"},
    {"run": "data remove storage mcdp_lib:internal timers[{name:\"t.g\"}]"},
    {"run": "function mcdp_lib:timer/start {name:\"t.cd\"}", "expect_error": "Missing argument ticks"}
  ],
  "teardown": ["kill @e[type=minecraft:marker]"]
}

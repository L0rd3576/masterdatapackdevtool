{
  "description": "Macro call rules: missing/extra keys, with-sources, tags, nested failure, return, context, load order",
  "setup": ["scoreboard players reset * mf", "kill @e[type=minecraft:marker]"],
  "steps": [
    {"assert_data": {"source": "storage mf:o", "path": "load_order", "equals": "[\"a\",\"b\"]"}},
    {"run": "function mf:two_lines {t:\"#x\"}", "expect_error": "Missing argument v to function mf:two_lines"},
    {"assert_output": {"command": "scoreboard players get #before mf", "contains": "none is set"}},
    {"run": "function mf:two_lines {t:\"#x\",v:3,extra:1}"},
    {"assert_score": {"target": "#x", "objective": "mf", "equals": 3}},
    {"run": "function mf:two_lines {t:\"#x\",v:\"nan\"}", "expect_error": "Expected integer"},
    {"assert_score": {"target": "#before", "objective": "mf", "equals": 1}},
    {"run": "function mf:plain {x:1}"},
    {"assert_score": {"target": "#plain", "objective": "mf", "equals": 1}},
    {"run": "data modify storage mf:o lst set value [1,2]"},
    {"run": "function mf:show with storage mf:o lst", "expect_error": "Expected Compound"},
    {"run": "function mf:show with storage mf:o nothing_here", "expect_error": "Found no elements matching"},
    {"run": "summon minecraft:marker 3 -55 3 {Tags:[\"mf.m\"],data:{x:42}}"},
    {"run": "function mf:show with entity @n[type=minecraft:marker,tag=mf.m] data"},
    {"assert_data": {"source": "storage mf:o", "path": "s", "equals": "\"42\""}},
    {"run": "function #mf:both {x:8}"},
    {"assert_data": {"source": "storage mf:o", "path": "raw", "equals": "8"}},
    {"run": "function mf:nested_fail"},
    {"assert_score": {"target": "#nf_after", "objective": "mf", "equals": 1}},
    {"run": "scoreboard players set #sf mf 7"},
    {"run": "function mf:store_fail"},
    {"assert_score": {"target": "#sf", "objective": "mf", "equals": 0}},
    {"run": "execute store result score #rv mf run function mf:ret {v:9}"},
    {"assert_score": {"target": "#rv", "objective": "mf", "equals": 9}},
    {"run": "execute store result score #rr mf run function mf:ret_run"},
    {"assert_score": {"target": "#rr", "objective": "mf", "equals": 11}},
    {"run": "execute store result score #nrr mf run function mf:no_return"},
    {"assert_output": {"command": "scoreboard players get #nrr mf", "contains": "none is set"}},
    {"run": "execute store result score #rf mf run function mf:ret_fail"},
    {"assert_score": {"target": "#rf", "objective": "mf", "equals": 0}},
    {"run": "function mf:outer"},
    {"assert_score": {"target": "#got", "objective": "mf", "equals": 5}},
    {"assert_score": {"target": "#inner", "objective": "mf", "equals": 1}},
    {"assert_score": {"target": "#outer", "objective": "mf", "equals": 1}},
    {"run": "execute as @n[type=minecraft:marker,tag=mf.m] at @s positioned ~ ~2 ~ run function mf:ctx"},
    {"assert_score": {"target": "#ctx_y", "objective": "mf", "equals": -55}},
    {"assert_data": {"source": "entity @n[type=minecraft:marker,tag=mf.here]", "path": "Pos", "equals": "[3.5d,-53.0d,3.5d]"}},
    {"run": "execute as @n[type=minecraft:marker,tag=mf.m] at @s run schedule function mf:sched_ctx 1t"},
    {"ticks": 1},
    {"assert_score": {"target": "#sched", "objective": "mf", "equals": 1}},
    {"assert": "unless entity @e[tag=mf.sched_self]"},
    {"assert": "if entity @e[type=minecraft:marker,tag=mf.sched_here,x=0,y=-60,z=0,distance=..0.1]"},
    {"run": "scoreboard players set #r mf 0"},
    {"run": "scoreboard players set #lim mf 100000"},
    {"run": "function mf:rec"},
    {"assert_score": {"target": "#r", "objective": "mf", "equals": 21845}}
  ],
  "teardown": ["kill @e[type=minecraft:marker]"]
}

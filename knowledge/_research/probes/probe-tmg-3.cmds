function zp:call_empty
forceload add 0 0 16 16
fill 0 64 0 8 65 8 minecraft:stone
fill 0 70 0 8 70 8 minecraft:stone
scoreboard objectives add zp.v dummy
scoreboard players set #neg1 zp.v -1
scoreboard players set #R zp.v 4
scoreboard players set #Rb2 zp.v 16
scoreboard players set #r2 zp.v 4
scoreboard players set #mode zp.v 2
execute positioned 4 65 4 run function zp:zone/sweep {R:4}
scoreboard players set #mode zp.v 1
execute positioned 4 70 4 run function zp:zone/sweep {R:4}
@ticks 60
# expect 36 lava at y65, none at y66 or y64, 45 stone at y65, 45 stone at y70
fill 0 66 0 8 66 8 minecraft:glass replace minecraft:lava
fill 0 64 0 8 64 8 minecraft:glass replace minecraft:lava
fill 0 65 0 8 65 8 minecraft:magma_block replace minecraft:lava
fill 0 65 0 8 65 8 minecraft:glass replace minecraft:stone
fill 0 70 0 8 70 8 minecraft:glass replace minecraft:stone
